{
  "name": "@arcstudio/root",
  "version": "2026.02.05-f18a041f",
  "description": "Advanced Resource Center Studio (ARC Studio), a monorepo.",
  "license": "ISC",
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build --parallel && pnpm update:version",
    "clean": "tsx scripts/src/lib/clean.ts",
    "update:version": "tsx scripts/src/lib/version.ts"
  },
  "dependencies": {
    "typescript": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.5.4"
  },
  "workspaces": [
    "api",
    "apps/*",
    "auth",
    "packages/*",
    "scripts",
    "web"
  ],
  "cleanConfig": {
    "defaultDirs": [
      "node_modules",
      "dist",
      ".next",
      ".turbo"
    ],
    "excludeDirs": [
      "scripts",
      "config"
    ]
  },
  "keywords": [
    ""
  ],
  "author": {
    "name": "Israel R. Jatobá",
    "email": "contact.israeljatoba@gmail.com",
    "url": "https://yeytaken.vercel.app/en-us"
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=24"
  }
}